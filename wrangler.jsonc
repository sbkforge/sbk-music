{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sbk-music",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Forks: replace this id with your own from `wrangler kv namespace create MUSIC`.
  "kv_namespaces": [
    { "binding": "MUSIC", "id": "10158fd06f57485bb82c9f8f9a0138b9" }
  ],
  "observability": { "enabled": true }
}
